<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetPass.API</RootNamespace>
    <AssemblyName>VetPass.API</AssemblyName>
    <UserSecretsId>vetpass-api</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Los comentarios de documentación describen decisiones de diseño y no
         cubren cada miembro público; no se exige lo segundo. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Los paquetes se agregan con `dotnet add package`, para que la
       herramienta resuelva la versión compatible con el SDK instalado:
         Microsoft.EntityFrameworkCore.Design
         Npgsql.EntityFrameworkCore.PostgreSQL
         Microsoft.AspNetCore.Authentication.JwtBearer
         Swashbuckle.AspNetCore
         Swashbuckle.AspNetCore.Annotations -->

</Project>
