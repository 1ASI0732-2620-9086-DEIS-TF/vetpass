<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para compilaciones de depuración. La API de desarrollo corre sobre HTTP
  en la máquina anfitriona: 10.0.2.2 es la dirección con que el emulador de
  Android la alcanza. Fuera de estas direcciones el tráfico en claro sigue
  prohibido, y en las compilaciones de entrega este archivo no participa.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
